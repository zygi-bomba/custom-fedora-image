[connection]
id=Split PW
uuid=49a4f650-6515-4284-a48e-70e817bbc453
type=vpn
autoconnect=false

[vpn]
authtype=password
autoconnect-flags=0
certsigs-flags=0
cookie-flags=2
disable_udp=no
enable_csd_trojan=no
gateway=https://vpn.ee.pw.edu.pl/
gateway-flags=2
gwcert-flags=2
lasthost-flags=0
pem_passphrase_fsid=no
prevent_invalid_cert=no
protocol=anyconnect
resolve-flags=2
stoken_source=disabled
xmlconfig-flags=0
password-flags=2
service-type=org.freedesktop.NetworkManager.openconnect

[vpn-secrets]
form:main:group_list=groupEE
lasthost=https://vpn.ee.pw.edu.pl/
save_passwords=yes

[ipv4]
method=auto
never-default=true 
route-metric=100

[ipv6]
addr-gen-mode=stable-privacy
method=auto

[proxy]
