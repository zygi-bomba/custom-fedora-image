[Unit]
Description=Hydrate VPN Secrets from Vault
# Ensure we have internet before trying to talk to Vault
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Path to the script we created earlier
ExecStart=/usr/local/bin/vpn-hydrate.sh
# Ensures the service stays "active" so it doesn't run repeatedly
RemainAfterExit=yes
# Optional: Add a delay if your Vault container takes time to start
# ExecStartPre=/usr/bin/sleep 5

[Install]
# This makes it start during the normal boot process
WantedBy=multi-user.target
